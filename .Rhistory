# Create the quadratic variable
dta$democracy_qd <- dta$democracy^2
# Quadratic model with specification from part (d)
model3 <- lm(instab ~ democracy + democracy_qd + lngdplag + coldwar, data= dta)
summary(model3)
# Quadratic Model for plot
model_quad <- lm(instab ~ democracy + democracy_qd, data = dta)
