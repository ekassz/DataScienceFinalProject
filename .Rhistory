#loading the data
dta <- readRDS("~/Documents/PPOL5200/Lab8/Covid_by_state_week.rds")
head(dta)
# Total cases for a given state
total_by <- function(data, state) {
sum<- sum(dta$positives[dta$state == state], na.rm = TRUE)
return(sum)
}
#report for OH and CA
total_by(dta, "OH")
total_by(dta, "CA")
library(dplyr)
#creating lag1, lag2, an lag3
dta <- dta %>%
arrange(state, friday) %>% #sorting the data by state and date
group_by(state) %>% # getting the results for each state
mutate(across(positives, list(lag1 = ~lag(.x, 1), # creating three lag variables based on positive cases
lag2 = ~lag(.x, 2),
lag3 = ~lag(.x, 3)))) %>%
ungroup()
library(dplyr)
library(dplyr)
#creating lag1, lag2, an lag3
dta <- dta %>%
arrange(state, friday) %>% #sorting the data by state and date
group_by(state) %>% # getting the results for each state
mutate(across(positives, list(lag1 = ~lag(.x, 1), # creating three lag variables based on positive cases
lag2 = ~lag(.x, 2),
lag3 = ~lag(.x, 3)))) %>%
ungroup()
# empty list to hold results from regression
models <- list()
# unique list of states
states <- unique(dta$state)
# creating new variable for lag_square
dta$positive_lag_sq <- dta$positives_lag3^2
# loop through  each state
for (s in states) {
state_data <- dta[dta$state == s, ]
models[[s]] <- lm(deaths ~ positives_lag3 + positive_lag_sq,
data = state_data) #fill in the lists with the results
}
# getting results for CA
summary(models[["CA"]])
library(ggplot2)
library(ggplot2)
# Step 1: define the function
# Arguments:
#   st     = the state name (must match a name in the list of models)
#   models = the list of regression results from part (4), one lm per state
#   xvar   = name of the x-axis variable (3rd week lag of cases)
#   yvar   = name of the outcome variable (deaths)
plot_state_fit <- function(st, models, xvar = "cases_lag3", yvar = "deaths") {
# Pull out the regression result for the chosen state
fit <- models[[st]]
# model.frame() returns the exact rows the model used, it lines up with the fitted values
mf <- model.frame(fit)
# Build a small data frame for plotting:
#   x      = lag 3 of cases
#   y      = observed deaths
#   fitted = deaths predicted by the regression
d <- data.frame(x = mf[[xvar]], y = mf[[yvar]], fitted = fitted(fit))
# Sort by x so the fitted line is drawn left to right without zigzagging
d <- d[order(d$x), ]
# Build the plot
ggplot(d, aes(x = x)) +
# Observed data as points (alpha makes overlapping points see-through)
geom_point(aes(y = y), alpha = 0.5) +
# Fitted values as a red line
geom_line(aes(y = fitted), color = "red", linewidth = 1) +
# Title and axis labels (paste() adds the state name to the title)
labs(title = paste("Fitted deaths vs. 3rd-week lag of cases:", st),
x = "Cases (lag 3 weeks)",
y = "Deaths") +
# Clean,
library(ggplot2)
# Step 1: make a function that plots one state
plot_state <- function(state) {
fit <- models[[state]]            # get the regression for this state
x <- model.frame(fit)$positives_lag3   # x-axis: lag 3 of cases
y <- model.frame(fit)$deaths       # y-axis: deaths
plot(x, y, xlab = "Cases (lag 3)", ylab = "Deaths", main = state)  # observed points
points(x, fitted(fit), col = "red")                                   # fitted values in red
}
# Step 2: call it for two states
plot_state("CA")
plot_state("OH")
library(ggplot2)
# Step 1: make a function that plots one state
plot_state <- function(st) {
fit <- models[[st]]                  # get the regression for this state
d <- model.frame(fit)                # the data the model actually used
plot(d$positives_lag3, d$deaths,     # observed deaths (black dots)
xlab = "Positives (lag 3 weeks)", ylab = "Deaths", main = st)
o <- order(d$positives_lag3)         # sort by x so the line draws smoothly
lines(d$positives_lag3[o], fitted(fit)[o], col = "red", lwd = 2)   # fitted values (red)
}
# Step 2: call it for two states
plot_state("California")
