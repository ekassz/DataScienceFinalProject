library(dplyr)
#creating lag1, lag2, an lag3
df <- df %>%
arrange(state, friday) %>% #sorting the data by state and date
group_by(state) %>% # getting the results for each state
mutate(across(positives, list(lag1 = ~lag(.x, 1), # creating three lag variables based on positive cases
lag2 = ~lag(.x, 2),
lag3 = ~lag(.x, 3)))) %>%
ungroup()
# empty list to hold results from regression
models <- list()
# unique list of states
states <- unique(df$state)
# creating new variable for lag_square
df$positive_lag_sq <- df$positives_lag3^2
# loop through  each state
for (s in states) {
state_data <- dta[dta$state == s, ]
models[[s]] <- lm(deaths ~ positives_lag3 + positive_lag_sq,
data = state_data)
}
# empty list to hold results from regression
models <- list()
# unique list of states
states <- unique(df$state)
# creating new variable for lag_square
df$positive_lag_sq <- df$positives_lag3^2
# loop through  each state
for (s in states) {
state_data <- df[df$state == s, ]
models[[s]] <- lm(deaths ~ positives_lag3 + positive_lag_sq,
data = state_data)
}
# getting results for CA
summary(models[["CA"]])
library(ggplot2)
# make a function that plots one state
plot_state <- function(st) {
fit <- models[[st]]                  # get the regression for this state
d <- model.frame(fit)                # the data the model actually used
plot(d$positives_lag3, d$deaths,     # observed deaths (black dots)
xlab = "Positives (lag 3)", ylab = "Deaths", main = st)
o <- order(d$positives_lag3)         # sort by x so the line draws smoothly
lines(d$positives_lag3[o], fitted(fit)[o], col = "red", lwd = 2)   # fitted values (red)
}
# call it for California
plot_state("CA")
# call it for CO
plot_state("CO")
